# Copy this file to .env.local and paste the Firebase Web App configuration.
# Never commit real project credentials or administrator identity.
VITE_FIREBASE_API_KEY=replace-with-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id

# Optional Firebase Web App value.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional. Leave empty to use the standard Firestore database: (default)
VITE_FIREBASE_DATABASE_ID=

# Application configuration. Use a non-sensitive administrator email locally.
VITE_ADMIN_EMAIL=replace-with-admin-email@example.com

# Local import verification only. Never commit real pilot credentials.
PILOT_IMPORT_EMAIL=replace-with-pilot-email@example.com
PILOT_IMPORT_USER_ID=replace-with-pilot-user-id
PILOT_IMPORT_PASSWORD=replace-with-pilot-password

# Firebase CLI deployment token. Keep the real value outside Git.
FIREBASE_TOKEN=replace-with-firebase-token