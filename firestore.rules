rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function ownsExisting() {
      return isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    function ownsIncoming() {
      return isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    function preservesOwner() {
      return isAdmin() || request.resource.data.userId == resource.data.userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', 'user') == 'user'
      );
      allow update: if (isOwner(userId) || isAdmin()) &&
        (isAdmin() || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /accounts/{accountId} {
      function hasValidCanonicalBacklink(data) {
        let canonicalId = data.get('canonicalAccountId', null);
        let canonical = canonicalId is string
          ? getAfter(/databases/$(database)/documents/canonicalAccounts/$(canonicalId)).data
          : null;
        return canonicalId == null || (
          canonicalId.size() > 0
          && canonical.userId == data.userId
          && canonical.legacyAccountId == accountId
          && canonical.approvalStatus == 'approved'
        );
      }

      allow get: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/accounts/$(accountId)) || ownsExisting()
      );
      allow list: if ownsExisting();
      allow create: if ownsIncoming() && hasValidCanonicalBacklink(request.resource.data);
      allow update: if ownsExisting() && ownsIncoming() && preservesOwner()
        && hasValidCanonicalBacklink(request.resource.data);
      allow delete: if ownsExisting();
    }

    match /canonicalAccounts/{accountId} {
      function hasValidOperationalLink(data) {
        let legacyId = data.get('legacyAccountId', null);
        let legacy = legacyId is string
          ? getAfter(/databases/$(database)/documents/accounts/$(legacyId)).data
          : null;
        return data.get('approvalStatus', 'draft') != 'approved' || (
          legacyId is string
          && legacyId.size() > 0
          && legacy.userId == data.userId
          && legacy.canonicalAccountId == accountId
        );
      }

      allow get: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/canonicalAccounts/$(accountId)) || ownsExisting()
      );
      allow list: if ownsExisting();
      allow create: if ownsIncoming() && hasValidOperationalLink(request.resource.data);
      allow update: if ownsExisting() && ownsIncoming() && preservesOwner()
        && hasValidOperationalLink(request.resource.data);
      allow delete: if false;
    }

    match /entries/{entryId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && preservesOwner();
      allow delete: if ownsExisting();
    }

    match /transactionRules/{ruleId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && preservesOwner();
      allow delete: if ownsExisting();
    }

    match /customRules/{ruleId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && preservesOwner();
      allow delete: if ownsExisting();
    }

    match /historicalCostReviewOverlays/{overlayId} {
      function hasExactOwner(data) {
        return isAuthenticated()
          && data.userId == request.auth.uid
          && data.ownerId == request.auth.uid
          && data.createdBy == request.auth.uid;
      }

      function hasAllowedFields(data) {
        return data.keys().hasAll([
          'overlayId', 'overlayVersion', 'schemaVersion', 'targetOperationId',
          'overlayType', 'originalDiagnosticCode', 'approvedInterpretedCostMinor',
          'pricePerGramMinor', 'valueBasis', 'sourceType', 'sourceReference',
          'approver', 'createdAt', 'approvedAt', 'supersedesOverlayId', 'status',
          'sourceInventoryAccountId', 'notes', 'confidenceNote',
          'historicalAssignmentConfirmed', 'userId', 'ownerId', 'createdBy', 'auditHash'
        ]) && data.keys().hasOnly([
          'overlayId', 'overlayVersion', 'schemaVersion', 'targetOperationId',
          'overlayType', 'originalDiagnosticCode', 'approvedInterpretedCostMinor',
          'pricePerGramMinor', 'valueBasis', 'sourceType', 'sourceReference',
          'approver', 'createdAt', 'approvedAt', 'supersedesOverlayId', 'status',
          'sourceInventoryAccountId', 'notes', 'confidenceNote',
          'historicalAssignmentConfirmed', 'userId', 'ownerId', 'createdBy', 'auditHash'
        ]);
      }

      function validNullableCost(value) {
        return value == null || (value is int && value >= 0);
      }

      function validCore(data) {
        return hasAllowedFields(data)
          && hasExactOwner(data)
          && data.overlayId == overlayId
          && data.overlayVersion is int
          && data.overlayVersion >= 1
          && data.schemaVersion == 'historical-cost-review-v1'
          && data.targetOperationId is string
          && data.targetOperationId.size() > 0
          && data.overlayType in [
            'merchant_receipt_cost', 'inventory_surplus_cost',
            'inventory_two_sided_correction', 'inventory_duplicate_exclusion',
            'inventory_non_surplus'
          ]
          && data.originalDiagnosticCode is string
          && data.originalDiagnosticCode.size() > 0
          && validNullableCost(data.approvedInterpretedCostMinor)
          && validNullableCost(data.pricePerGramMinor)
          && data.valueBasis in [
            'total', 'actual_weight', 'standard21_weight',
            'carrying_cost_transfer', 'exclusion'
          ]
          && data.sourceType in [
            'original_invoice', 'merchant_statement', 'manual_records',
            'bank_or_cash_evidence', 'approved_accounting_estimate', 'other'
          ]
          && data.sourceReference is string
          && data.approver is string
          && data.createdAt is string
          && data.createdAt.size() > 0
          && (data.approvedAt == null || data.approvedAt is string)
          && (data.supersedesOverlayId == null || data.supersedesOverlayId is string)
          && data.status in ['draft', 'approved', 'rejected']
          && (data.sourceInventoryAccountId == null || data.sourceInventoryAccountId is string)
          && data.notes is string
          && data.confidenceNote is string
          && data.historicalAssignmentConfirmed is bool
          && data.auditHash is string
          && data.auditHash.matches('^[a-f0-9]{64}$');
      }

      function validApproval(data) {
        return data.status != 'approved' || (
          data.approvedAt is string
          && data.approvedAt.size() > 0
          && data.approver.size() > 0
          && data.historicalAssignmentConfirmed == true
          && (data.sourceReference.size() > 0 || data.notes.size() > 0)
          && (
            !(data.overlayType in ['merchant_receipt_cost', 'inventory_surplus_cost'])
            || (data.approvedInterpretedCostMinor is int
              && data.approvedInterpretedCostMinor > 0)
          )
          && (
            data.overlayType != 'inventory_two_sided_correction'
            || (data.sourceInventoryAccountId is string
              && data.sourceInventoryAccountId.size() > 0)
          )
        );
      }

      function validReferencedSupersession(data) {
        let prior = get(/databases/$(database)/documents/historicalCostReviewOverlays/$(data.supersedesOverlayId)).data;
        return hasExactOwner(prior)
          && prior.status == 'approved'
          && prior.targetOperationId == data.targetOperationId
          && data.overlayVersion > prior.overlayVersion;
      }

      function validSupersession(data) {
        return data.supersedesOverlayId == null
          || validReferencedSupersession(data);
      }

      function preservesDraftIdentity() {
        return request.resource.data.overlayId == resource.data.overlayId
          && request.resource.data.overlayVersion == resource.data.overlayVersion
          && request.resource.data.targetOperationId == resource.data.targetOperationId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.supersedesOverlayId == resource.data.supersedesOverlayId;
      }

      allow read: if hasExactOwner(resource.data);
      allow create: if validCore(request.resource.data)
        && validApproval(request.resource.data)
        && validSupersession(request.resource.data);
      allow update: if hasExactOwner(resource.data)
        && resource.data.status == 'draft'
        && preservesDraftIdentity()
        && validCore(request.resource.data)
        && validApproval(request.resource.data)
        && validSupersession(request.resource.data);
      allow delete: if false;
    }
    match /inventory_checks/{checkId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && preservesOwner() &&
        resource.data.get('status', '') != 'posted' &&
        resource.data.get('isResolved', false) != true;
      allow delete: if ownsExisting() &&
        resource.data.get('status', '') != 'posted' &&
        resource.data.get('isResolved', false) != true;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Dedicated, isolated documents for the post-connection verification only.
    match /_connection_tests/{testId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
