{
    "name":  "react-example",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx server.ts",
                    "build":  "vite build",
                    "typecheck":  "tsc --noEmit",
                    "start":  "node server.ts",
                    "preview":  "vite preview",
                    "clean":  "rm -rf dist",
                    "lint":  "tsc --noEmit",
                    "deploy":  "npm run build \u0026\u0026 firebase deploy --only hosting",
                    "test":  "vitest run --testTimeout=30000",
                    "test:golden":  "vitest run src/lib/__tests__/phase5GoldenDataset.test.ts",
                    "test:golden:prerequisites":  "vitest run src/lib/__tests__/inventoryCostPhase5.test.ts src/lib/__tests__/historicalInventoryOverlay.test.ts src/lib/__tests__/costRecalculationPhase5.test.ts src/lib/__tests__/costIntegrity.test.ts",
                    "golden:generate":  "tsx scripts/generate-phase5-golden-baseline.ts"
                },
    "dependencies":  {
                         "@tailwindcss/vite":  "^4.1.14",
                         "@vitejs/plugin-react":  "^5.0.4",
                         "clsx":  "^2.1.1",
                         "date-fns":  "^4.1.0",
                         "dotenv":  "^17.2.3",
                         "express":  "^4.21.2",
                         "firebase":  "^12.13.0",
                         "framer-motion":  "^12.38.0",
                         "lucide-react":  "^0.546.0",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "recharts":  "^3.8.1",
                         "tailwind-merge":  "^3.5.0",
                         "tsx":  "^4.21.0",
                         "xlsx":  "^0.18.5",
                         "zustand":  "^5.0.12"
                     },
    "devDependencies":  {
                            "@types/express":  "^4.17.21",
                            "@types/node":  "^22.14.0",
                            "firebase-tools":  "^15.16.0",
                            "tailwindcss":  "^4.1.14",
                            "typescript":  "~5.8.2",
                            "vite":  "^6.2.0",
                            "vitest":  "^4.1.9"
                        }
}
