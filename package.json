                    "build":  "vite build",
                    "start":  "node server.ts",
                    "preview":  "vite preview",
                    "clean":  "rm -rf dist",
                    "lint":  "tsc --noEmit",
                    "deploy":  "npm run build \u0026\u0026 firebase deploy --only hosting",
